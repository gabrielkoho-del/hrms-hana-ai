# Primary: Gemini 3.1 Flash Lite (free tier)
GEMINI_API_KEY=your-key-here

GROQ_API_KEY=your-key-here

# Provider switch (default: gemini)
LLM_PROVIDER=gemini

# RAG paths
CHROMA_DB_PATH=C:/Users/USER/Documents/hrms-api/data/chroma_db
CHROMA_COLLECTION_NAME=hr_policies

# Optional tuning
RAG_TOP_K=5                               # Chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.20

# Excel export
EXPORT_DIR=C:/Users/USER/Documents/hrms-api/exports
AGENT_BASE_URL=http://localhost:8000
EXPORT_MAX_AGE_HOURS=24
LARGE_RESULT_THRESHOLD=20


# ─── Database ─────────────────────────────────────────────────────
DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};server=localhost;database=HRMSlocal;Trusted_Connection=yes;


# ── Dev toggle ──
GROQ_MOCK=false                       # Set true for pytest
LOG_LEVEL=INFO


# ─── JWT for local testing ────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_AUDIENCE=hrms-api
JWT_ISSUER_ALLOWLIST=local-dev-issuer


# ─── Dev Test Token ───────────────────────────────────────────────
# Generate: python tools/generate_test_jwt.py --role hr
# Paste token here for local testing (email/pass login in LibreChat)
DEV_TEST_TOKEN=eyJhbGci...       # Paste generated token here


# MCP Bridge Server talks to DAB
DAB_BASE_URL=http://localhost:5000


# HRMS DAB — Local Development Environment
DAB_ENVIRONMENT=Development
DATABASE_CONNECTION_STRING=Server=localhost;Database=HRMSlocal;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=dab-hrms-localdev


# === reflexive mode ===
AGENT_MODE=reflexive


# Chart mode: mermaid | matplotlib | auto | base64
CHART_MODE=auto

# For matplotlib mode — local dev
CHART_BASE_URL=http://localhost:8000

# For production — update to your public domain
# CHART_BASE_URL=https://api.yourcompany.com

# Output directory (same for all modes)
CHART_OUTPUT_DIR=C:\Users\USER\Documents\hrms-api\agent\output
CHART_MAX_CATEGORIES=20
CHART_DPI=150


# ─── SAP HANA Cloud (hana-mcp-server) ─────────────────────────────
HANA_HOST=your-hana-host-here.hana.prod-ap21.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your-hana-password-here
HANA_SCHEMA=SFLIGHT
HANA_SSL=true
HANA_ENCRYPT=true
HANA_VALIDATE_CERT=true
