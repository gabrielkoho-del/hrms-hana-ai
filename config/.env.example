# Primary: Gemini 3.5 Flash (free tier)
GEMINI_API_KEY=your-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=3072

# Fallback embedder (optional — enables Cohere fallback when Gemini is rate-limited)
# COHERE_API_KEY=your-cohere-trial-key
# COHERE_EMBEDDING_MODEL=embed-english-v3.0
# COHERE_EMBEDDING_DIM=1024

# Provider switch (default: gemini)
LLM_PROVIDER=gemini

# RAG paths
CHROMA_DB_PATH=C:/Users/USER/Documents/hrms-api/data/chroma_db
CHROMA_COLLECTION_NAME=hr_policies

# Optional tuning
RAG_TOP_K=5                               # Chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.20

# Excel export
EXPORT_DIR=C:/Users/USER/Documents/hrms-api/exports
AGENT_BASE_URL=http://localhost:8001
EXPORT_MAX_AGE_HOURS=24
LARGE_RESULT_THRESHOLD=20


# --- Database -----------------------------------------------------
DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};server=localhost;database=HRMSlocal;Trusted_Connection=yes;


# --- Custom UI tokens (for /ui/config endpoint) ---
# In dev (AUTH_MODE=test), tokens are generated on-the-fly from JWT_SECRET.
# In production, set these to pre-issued JWTs for the custom HR chat UI.
# HR_EMPLOYEE_TOKEN=eyJ...
# HR_ADMIN_TOKEN=eyJ...

# -- Dev toggle --
GROQ_MOCK=false                       # Set true for pytest
LOG_LEVEL=INFO


# --- JWT for local testing ----------------------------------------
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_AUDIENCE=hrms-api
JWT_ISSUER_ALLOWLIST=local-dev-issuer


# --- Dev Test Token -----------------------------------------------
# Generate: python tools/generate_test_jwt.py --role hr
# Paste token here for local testing (email/pass login in LibreChat)
DEV_TEST_TOKEN=eyJhbGci...       # Paste generated token here


# MCP Bridge Server talks to DAB
DAB_BASE_URL=http://localhost:5000


# HRMS DAB -- Local Development Environment
DAB_ENVIRONMENT=Development
DATABASE_CONNECTION_STRING=Server=localhost;Database=HRMSlocal;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=dab-hrms-localdev


# === reflexive mode ===
AGENT_MODE=reflexive


# Chart mode: mermaid | matplotlib | auto | base64
CHART_MODE=auto

# For matplotlib mode -- local dev (must match the FastAPI server port)
CHART_BASE_URL=http://localhost:8001

# For production -- update to your public domain
# CHART_BASE_URL=https://api.yourcompany.com

# Output directory (same for all modes)
CHART_OUTPUT_DIR=C:\Users\USER\Documents\hrms-api\agent\output
CHART_MAX_CATEGORIES=20
CHART_DPI=150


# SAP HANA MCP Server -- Agent connection (no DB credentials here)
# Set this to your deployed MCP server URL in production.
HANAMCP_HTTP_URL=http://127.0.0.1:3100/mcp


# --- SAP HANA Cloud (hana-mcp-server) -----------------------------
# These are consumed by the MCP server process, not the Python agent.
# Place them in hana-mcp-server/.env instead.
HANA_HOST=your-hana-host-here.hana.prod-ap21.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your-hana-password-here
HANA_SCHEMA=SFLIGHT
HANA_SSL=true
HANA_ENCRYPT=true
HANA_VALIDATE_CERT=true

# --- HANA Business Semantics ---------------------------------------
# Path to HR business semantics JSON loaded by hana-mcp-server.
# Used by hana_explain_table to enrich table/column descriptions.
HANA_SEMANTICS_PATH=./hana-mcp-server/config/hana-semantics-hr.json

# --- Dynamic Dashboard -------------------------------------------------------
# Tenant used by the dynamic dashboard data endpoints (via os.getenv).
DATASET_DEFAULT_TENANT=RDEMOROCKFORT
