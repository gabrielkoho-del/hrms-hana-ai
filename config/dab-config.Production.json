{
  "runtime": {
    "host": {
      "mode": "production",
      "authentication": {
        "provider": "EntraID",
        "jwt": {
          "audience": "@env('DAB_ENTRA_AUDIENCE')",
          "issuer": "@env('DAB_ENTRA_ISSUER')"
        }
      },
      "cors": {
        "origins": [
          "@env('CORS_ALLOWED_ORIGIN')"
        ],
        "allow-credentials": false
      }
    },
    "graphql": {
      "allow-introspection": false
    },
    "telemetry": {
      "log-level": {
        "default": "Warning",
        "Azure.DataApiBuilder.Core.Resolvers.IQueryExecutor": "Warning",
        "Azure.DataApiBuilder.Core.Resolvers.SqlQueryEngine": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}